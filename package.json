  "private": true,
  "license": "MIT",
  "author": "BlueFunny & Claude",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoNetwork-Astral/mcpc.git"
  },
  "homepage": "https://github.com/XiaoNetwork-Astral/mcpc",
  "bugs": {
    "url": "https://github.com/XiaoNetwork-Astral/mcpc/issues"
  },
  "type": "module",
  "bin": {
    "mcpc": "bin/mcpc.mjs"
  },
  "files": [
    "bin",
    "installer.ps1",
    "installer.sh",
    "lib",
    "scripts",
    "skill"
  ],
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
